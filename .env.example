LOCAL_BACKUP_DIR="/var/lib/vz/dump"
TARGET_BACKUP_DIR="/mnt/ftp-backup"
CONTAINERS="102,103"
# `CONTAINERS` is kept for backwards compatibility and may include LXC CTIDs and/or QEMU VMIDs.
DAYS_TO_KEEP=7
EMAIL_RECIPIENT="your-email@example.com"
# Suported values: gzip, lzo, zstd
COMPRESSION="zstd"
CHECK_MOUNTPOINT=true
# Off-site upload via an rclone remote (reliable multipart upload + verification).
# STRONGLY RECOMMENDED: without it the script falls back to moving files across the
# mounted TARGET_BACKUP_DIR, which is unreliable for large files. Format: remote:path
RCLONE_REMOTE="BackupStorageS3:backup-node-1/dump"
# Minimum free space (MB) required in LOCAL_BACKUP_DIR before a dump starts. Guards
# against a dump aborting mid-write on a full disk and leaving a corrupt partial file.
# Set to 0 to disable the check.
MIN_FREE_MB=22000
